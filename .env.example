# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpassword
MONGO_DB_NAME=pharma_supply_chain
MONGO_URI=mongodb://root:rootpassword@127.0.0.1:27017/pharma_supply_chain?authSource=admin&directConnection=true

# ------------------------------------------------------------------------------
# 3. Time-Series Telemetry Store (Apache Cassandra)
# ------------------------------------------------------------------------------
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_CLUSTER_NAME=PharmaCluster
CASSANDRA_KEYSPACE=pharma_telemetry
CASSANDRA_MAX_HEAP=1024M
CASSANDRA_HEAP_NEW=256M

# ------------------------------------------------------------------------------
# 4. Graph Database (Neo4j)
# ------------------------------------------------------------------------------
NEO4J_HOST=127.0.0.1
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pharma_secret
NEO4J_AUTH=neo4j/pharma_secret
NEO4J_URI=bolt://127.0.0.1:7687

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
PANDAPROXY_PORT=8082
SCHEMA_REGISTRY_PORT=8081
REDPANDA_ADMIN_PORT=9644